[{"title":"شقة مفروشة بإربد الحي الشرقي: بدون تأمين وإيجار من المالك مباشرة!","description":"للإيجار الفوري في قلب الحي الشرقي بإربد! شقة مفروشة بالكامل بمساحة 150م²، 3 غرف نوم و2 حمام. تمتع بالراحة والأمان مع ميزة \"بدون تأمين\" وإيجار مباشر من المالك لتوفير عمولة السمسرة. الشقة بالطابق الأول، مجهزة بمكيفات راكبة وشرفة جميلة، وعمر البناء حديث (1-5 سنوات). ساعة كهرباء مفصولة ولا يوجد رسوم بناء. موقع استراتيجي بالقرب من بنوك، مطاعم ومسجد. جاهزة للسكن الفوري، مناسبة للجميع. لا تفوت الفرصة!","price":350.0,"location":"إربد","image_url":"https://pub-158212dafa5344d4bbf078a74da2305a.r2.dev/0c1a88fb558243738f3265b7cd96b8e9.jpg","category_id":301,"attributes":{"city":"إربد","floor":"1","rooms":3,"region":"الحي الشرقي","bathrooms":2,"furnished":"مفروشة","image_urls":["https://pub-158212dafa5344d4bbf078a74da2305a.r2.dev/0c1a88fb558243738f3265b7cd96b8e9.jpg","https://pub-158212dafa5344d4bbf078a74da2305a.r2.dev/74da4138918c45a9bb6fd8d6846894f3.jpg","https://pub-158212dafa5344d4bbf078a74da2305a.r2.dev/9e337449749f4664981f3024809e171d.jpg","https://pub-158212dafa5344d4bbf078a74da2305a.r2.dev/8323da951acf4f69bc1c1dc972765833.jpg","https://pub-158212dafa5344d4bbf078a74da2305a.r2.dev/612504a9c84f48419028177d0bdfbef5.jpg","https://pub-158212dafa5344d4bbf078a74da2305a.r2.dev/52d4096ed6cc4456bbc9911c698c893e.jpg","https://pub-158212dafa5344d4bbf078a74da2305a.r2.dev/dbc2b0e9dc9147918736fed6fb0bf772.jpg"],"building_age":"1 - 5 سنوات","dynamic_data":{"age":"1 - 5 سنوات","area":"150","floor":"1","facade":"شمالية","nearby":["بنك / صراف آلي","مطعم","مسجد"],"bedrooms":"3","bathrooms":"2","furnishing":"مفروشة","meters_setup":["ساعة كهرباء مفصولة"],"water_supply":["مياه سلطة فقط"],"main_features":["شرفة / بلكونة"],"rent_duration":"شهري","extra_features":[],"target_tenants":["الجميع / بدون شروط"],"advertiser_type":"من المالك مباشرة","cooling_features":["مكيفات راكبة"],"heating_features":[],"building_fees_status":["لا يوجد رسوم"],"property_restrictions":[],"security_deposit_type":"بدون تأمين","wa